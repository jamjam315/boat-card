# tools/apple-jwt-check.mjs 用の設定。
#
# このファイルをコピーして tools/.env.local を作る:
#   cp tools/env.local.sample tools/.env.local
#
# .env.local（.env.*）と *.p8 は .gitignore 済み。コミットされない。
# **このサンプルには絶対に現物を書かないこと**（main はそのまま公開される）。

# App Store Connect → ユーザーとアクセス → 統合 → App内課金
# で作ったキーのキーID（10桁）。
APPLE_KEY_ID=

# 同じ画面に出ている Issuer ID（36桁のUUID）。
# **「App Store Connect API」タブのIssuer IDと取り違えないこと。**
APPLE_ISSUER_ID=

APPLE_BUNDLE_ID=com.mtpworks.teiyomi

# .p8 の場所。絶対パス・~/ 始まり・tools/ からの相対、どれでもよい。
APPLE_PRIVATE_KEY_FILE=~/Documents/AuthKey_XXXXXXXXXX.p8

# ファイルではなく文字列で渡したいときはこちら（上を消して使う）。
# 改行は実際の改行でも \n の2文字でもよい。
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Sandboxの購入のtransactionId。分からなければ空でよい
# （見つからないIDでも、401か404かの違いは分かる）。
TRANSACTION_ID=

# 1 にすると Edge Function と同じ WebCrypto で署名する（切り分け用）。
# FORCE_WEBCRYPTO=
