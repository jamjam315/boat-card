# データ本体(results/ program/ raw/)は data ブランチにあり、main には置かない。
# GitHub Pagesは main をそのまま公開するため、ここに戻すと公開サイトが
# 1GB上限に近づく(詳しくは DATA.md)。
# ローカルで data ブランチのworktreeをこの中に作ってしまった場合や、
# 環境変数の設定漏れでスクリプトがここに書いてしまった場合に、
# 誤ってmainへコミットされるのを防ぐ。
/results/
/program/
/raw/

# 公式からダウンロードした一時ファイル(取り込み後は不要)
/b??????.lzh
/k??????.lzh
/B??????.TXT
/K??????.TXT

# バックフィルの実行ログ(手元の作業記録。リポジトリには残さない)
/backfill_*_log.txt
/backfill_*_stdout.txt

__pycache__/

# ===== 秘密の値を、うっかり公開してしまわないための保険 =====
# mainブランチはGitHub Pagesでそのまま全世界に公開される。ここに置いた
# ファイルは誰でも読めてしまうため、鍵やパスワードの類は名前の時点で弾く。
# (Supabaseのサービスロールキー・Stripeのシークレットキー・VAPIDの秘密鍵などは
#  リポジトリではなく、SupabaseとGitHubのシークレット設定に入れる)
.env
.env.*
!.env.example
supabase/.env
supabase/.env.*
*.pem
*.key
*.p8
*.p12
service-account*.json

# エディタ・作業ツールの手元設定(この端末の都合であって、サイトの一部ではない)
.claude/

# Deno/npm の依存キャッシュ。Edge Functionを手元で型チェック・テストしたときに
# できる作業用の置き場で、サイトの一部でもデプロイ対象でもない
# (Supabaseはデプロイ時に自分で解決する)。2,000ファイル超あり、
# mainに入るとGitHub Pagesでそのまま公開されてしまう。
node_modules/
deno.lock
